{
  "description": "NexaForge SecureCode agent guard and stop gate for Codex. Replace <PYTHON> and <APP> (on Windows <PYTHON> must have no spaces: use the 8.3 short path), then trust the hooks in /hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "\"<PYTHON>\" -I \"<APP>/scripts/adapters/codex_hook.py\"",
            "commandWindows": "<PYTHON> -I \"<APP>/scripts/adapters/codex_hook.py\"", "timeout": 20,
            "statusMessage": "Org AI agent guard" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"<PYTHON>\" -I \"<APP>/scripts/stop_gate.py\"",
            "commandWindows": "<PYTHON> -I \"<APP>/scripts/stop_gate.py\"", "timeout": 90 }
        ]
      }
    ]
  }
}
